# ──────────────────────────────────────────────────────────────
# Panda Lavanda Telegram Bot — пример переменных окружения.
#
# Скопируйте в apps/telegram-bot/.env (файл в .gitignore, не коммитится):
#   cp apps/telegram-bot/.env.example apps/telegram-bot/.env
#
# Этот файл грузится Node-флагом --env-file-if-exists=.env, который
# прописан в npm-скриптах dev/start пакета @panda-lavanda/telegram-bot.
# ──────────────────────────────────────────────────────────────

# Токен бота, который выдаёт @BotFather. Тот же, что и в apps/api/.env.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Chat id администратора (ваш личный чат с ботом). Узнать у @userinfobot.
# Бот принимает команды ТОЛЬКО из этого чата.
TELEGRAM_ADMIN_CHAT_ID=123456789

# URL API-бэкенда (apps/api). Должен совпадать с адресом apps/api (порт 4000).
BACKEND_URL=http://localhost:4000

# Окружение приложения.
NODE_ENV=development
