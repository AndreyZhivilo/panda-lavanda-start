{
  "name": "@panda-lavanda/telegram-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx/esm --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx/esm src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@panda-lavanda/application": "*",
    "@panda-lavanda/domain": "*",
    "@panda-lavanda/infrastructure": "*",
    "@panda-lavanda/shared": "*",
    "grammy": "^1.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  }
}
