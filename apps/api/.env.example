# ──────────────────────────────────────────────────────────────
# Panda Lavanda API — пример переменных окружения.
#
# Скопируйте в apps/api/.env (файл в .gitignore, не коммитится):
#   cp apps/api/.env.example apps/api/.env
#
# Этот файл грузится Node-флагом --env-file-if-exists=.env, который
# прописан в npm-скриптах dev/start/seed пакета @panda-lavanda/api.
# ──────────────────────────────────────────────────────────────

# Учётные данные PostgreSQL (используются docker-compose.yml для инициализации БД).
POSTGRES_USER=panda
POSTGRES_PASSWORD=panda
POSTGRES_DB=panda

# Строка подключения к PostgreSQL.
# Локально (контейнер пробрасывает порт 5432 на хост):
DATABASE_URL=postgresql://panda:panda@localhost:5432/panda

# Порт, на котором слушает Fastify-сервер.
PORT=4000

# Разрешённые CORS-источники (через запятую). Адрес веб-приложения в dev.
CORS_ORIGIN=http://localhost:3000

# Окружение приложения.
NODE_ENV=development

# Telegram: токен бота и chat id администратора.
# Токен выдаёт @BotFather. Chat id можно узнать у @userinfobot.
# Используются order-notifier'ом для отправки уведомлений о новых заказах.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_ADMIN_CHAT_ID=123456789

# Каталог для загруженных фото товаров (относительно cwd, если путь не абсолютный).
# Создаётся автоматически. Раздаётся плагином @fastify/static по PUBLIC_UPLOAD_PATH.
UPLOAD_DIR=./uploads

# Публичный путь, по которому раздаются загруженные файлы.
PUBLIC_UPLOAD_PATH=/uploads
