# ──────────────────────────────────────────────────────────────
# Panda Lavanda — пример общих переменных окружения (корень репо).
#
# Скопируйте в ТРИ файла (все в .gitignore, не коммитятся):
#
#   1. cp .env.example .env
#      Корень репо — читается docker-compose.yml для инициализации БД
#      (POSTGRES_USER/PASSWORD/DB) и сервисом `migrate`.
#
#   2. cp .env.example apps/api/.env
#      API-бэкенд (apps/api) — читается Node-флагом --env-file-if-exists=.env
#      в npm-скриптах dev/start/seed. Здесь нужны DATABASE_URL, PORT,
#      CORS_ORIGIN (см. apps/api/.env.example).
#
#   3. cp .env.example apps/web/.env
#      Веб-приложение (apps/web) — читается Vite loadEnv относительно
#      config.root = apps/web/. Здесь нужен BACKEND_URL (URL API-бэкенда).
#
# Зачем три: каждый процесс грузит .env из своей «домашней» папки.
# Бэкенд владеет подключением к БД; фронтенд знает только адрес бэкенда.
# ──────────────────────────────────────────────────────────────

# Учётные данные PostgreSQL (контейнер `db`).
# Используются docker-compose.yml для инициализации БД.
POSTGRES_USER=panda
POSTGRES_PASSWORD=panda
POSTGRES_DB=panda

# Строка подключения к PostgreSQL — используется API-бэкендом (apps/api),
# drizzle-kit (generate/migrate/studio) и seed-скриптом.
# Хост — localhost, т.к. бэкенд работает вне Docker и стучится на проброшенный
# порт 5432.
#
# ВАЖНО: внутри docker-compose (сервис `migrate`) хост БД подменяется на `db` —
# это имя сервиса во внутренней сети. См. docker-compose.yml → migrate.environment.
DATABASE_URL=postgresql://panda:panda@localhost:5432/panda

# Порт, на котором слушает API-бэкенд (apps/api).
PORT=4000

# Разрешённые CORS-источники для API-бэкенда (через запятую).
# Адрес веб-приложения в dev.
CORS_ORIGIN=http://localhost:3000

# URL API-бэкенда — нужен веб-приложению (apps/web), чтобы обращаться к API.
# Должен совпадать с адресом, на котором поднят apps/api (по умолчанию порт 4000).
BACKEND_URL=http://localhost:4000
